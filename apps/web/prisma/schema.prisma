generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js ----------

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime           @default(now())
  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  videos            Video[]
  replies           Reply[]
  /// The workspace this user is working in when they belong to several (e.g. their own and an employer's).
  activeWorkspaceId String?
  assignedClients   Client[]           @relation("ClientAssignee")
  invitesSent       Invite[]           @relation("InviteSender")
  supportTickets    SupportTicket[]
  teamNotifications TeamNotification[]
  noticesSent       StaffNotice[]      @relation("NoticeFrom")
  noticesReceived   StaffNotice[]      @relation("NoticeTo")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Workspaces & billing ----------

enum Plan {
  FREE
  SOLO
  STUDIO
  AGENCY
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                    String             @id @default(cuid())
  name                  String
  plan                  Plan               @default(FREE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  subscriptionStatus    String?
  /// A paid plan given free by the founder (trials, partners). Used whenever there's no active subscription.
  complimentaryPlan     Plan?
  currentPeriodEnd      DateTime?
  /// Client seats bought on top of the plan's included seats.
  extraClientSeats      Int                @default(0)
  /// Staff seats bought on top of the plan's included staff (Studio and Agency).
  extraStaffSeats       Int                @default(0)
  /// Paid add-on: keep encrypted copies on the server instead of expiring them.
  cloudBackup           Boolean            @default(false)
  /// Paid add-on: AI transcripts and summaries. Transcripts are made on the
  /// team's devices; only the transcript text is sent to Claude for the summary.
  aiAssist              Boolean            @default(false)
  /// AI summaries given free by the founder (complimentary plans, no card).
  aiAssistComplimentary Boolean            @default(false)
  /// Fingerprint of the team's end-to-end key. The key itself never reaches the server.
  keyFingerprint        String?
  /// Someone left without an admin removing them (deleted their account), so
  /// the keys still need resetting. Holds their name for the prompt.
  keyResetNeeded        String?
  /// IANA time zone used for due dates and reminders, e.g. "Australia/Sydney".
  timezone              String?
  /// Reminder rules pre-selected on new to-dos (see lib/schedule.ts ReminderRule[]).
  reminderDefaults      Json?
  remindClientDefault   Boolean            @default(true)
  remindTeamDefault     Boolean            @default(false)
  /// Optional note the business adds to every reminder email.
  reminderMessage       String?
  /// Where client replies to reminder emails go.
  reminderReplyTo       String?
  /// Custom branding (paid plans) shown to clients: logo image and accent colour (#rrggbb).
  brandLogo             Bytes?
  brandLogoType         String?
  brandColor            String?
  /// Bumped on every branding change so logo URLs bust caches.
  brandVersion          Int                @default(0)
  createdAt             DateTime           @default(now())
  members               Membership[]
  videos                Video[]
  clients               Client[]
  items                 Item[]
  invites               Invite[]
  keyRotations          KeyRotation[]
  aiUsages              AiUsage[]
  teamNotifications     TeamNotification[]
  staffNotices          StaffNotice[]
}

/// An invitation for a staff member to join a workspace. The link carries a
/// secret in its #fragment that unwraps the team key, so the server never sees it.
model Invite {
  id           String    @id @default(cuid())
  /// sha256 of the token in the invite link's path.
  tokenHash    String    @unique
  role         Role      @default(MEMBER)
  /// Who it is for, shown on the team page only.
  email        String?
  /// The team key, wrapped with the secret in the link fragment.
  teamKeyWrap  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Which team emails an owner or admin gets.
enum NotifyScope {
  ALL // everyone's clients
  SELECTED // only the staff members they picked
  MINE // only clients assigned to them (and replies they'd get anyway)
  OFF
}

model Membership {
  id               String      @id @default(cuid())
  role             Role        @default(MEMBER)
  /// What a MEMBER may do, set by the owner or an admin (lib/permissions.ts).
  /// Owners and admins always have full access; these only apply to members.
  /// See every client, not only the ones assigned to them (and unassigned "Shared" ones).
  seeAllClients    Boolean     @default(false)
  /// Add new clients (they're assigned to the member who adds them).
  addClients       Boolean     @default(true)
  /// Delete any video they can see, not only the ones they recorded.
  deleteAnyVideo   Boolean     @default(false)
  /// Send one recording to several clients at once (only clients they can see).
  sendToMany       Boolean     @default(true)
  /// Owners and admins: which client replies they're emailed about (lib/teamNotify.ts).
  replyNotify      NotifyScope @default(MINE)
  /// With SELECTED: replies from the clients of these staff members (user ids).
  replyNotifyStaff String[]    @default([])
  /// Owners and admins: which videos sent by staff they're emailed about.
  sentNotify       NotifyScope @default(OFF)
  /// With SELECTED: the staff members they asked to hear about ("Tell me when they send a video").
  sentNotifyStaff  String[]    @default([])
  userId           String
  workspaceId      String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ---------- Videos ----------

enum VideoStatus {
  RECORDING // chunks still arriving
  UPLOADED // raw file complete, playable as-is
  PROCESSING // transcoding to HLS
  READY // HLS available
  FAILED
  EXPIRED // server copy deleted after the relay window; originals live on devices
}

model Video {
  id                   String        @id // short public id used in share links
  title                String        @default("Untitled recording")
  status               VideoStatus   @default(RECORDING)
  mimeType             String
  durationMs           Int?
  sizeBytes            BigInt        @default(0)
  storageKey           String
  uploadId             String? // S3 multipart upload id
  playbackUrl          String? // HLS url once transcoded
  thumbnailUrl         String?
  viewCount            Int           @default(0)
  /// Sent to a client while the upload was still finishing: email them once it's done.
  emailClientWhenReady Boolean       @default(false)
  password             String?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  ownerId              String
  workspaceId          String
  /// The client this video was sent to. Videos are private: only workspace
  /// members and this client can watch them.
  clientId             String?
  client               Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// End-to-end encryption. The server stores only ciphertext and these
  /// wrapped (encrypted) copies of the video's key:
  encrypted            Boolean       @default(false)
  teamKeyWrap          String? /// video key, wrapped with the team key
  clientKeyWrap        String? /// video key, wrapped with the recipient client's key
  parentKeyWrap        String? /// reply media key, wrapped with the conversation's video key
  /// When the relay copy is deleted (null = kept, e.g. cloud backup).
  purgeAt              DateTime?
  /// When the recorder was emailed that the relay copy is deleted within 24 hours.
  /// Cleared whenever purgeAt is rescheduled (cloud backup turned off again).
  expiryWarnedAt       DateTime?
  /// Set on a copy made to send the same recording to another client. The
  /// copy shares the original's stored file and key but has its own private
  /// conversation, so clients never see each other's replies.
  sourceId             String?
  source               Video?        @relation("VideoCopies", fields: [sourceId], references: [id], onDelete: Cascade)
  copies               Video[]       @relation("VideoCopies")
  /// Set when this video is the media of a reply in another video's conversation.
  replyToId            String?
  /// sha256 of a one-time token that lets a guest (no account) upload this reply's media.
  uploadTokenHash      String?
  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parts                UploadPart[]
  replies              Reply[]       @relation("Conversation")
  asReply              Reply?        @relation("ReplyMedia")
  reactions            Reaction[]
  insight              VideoInsight?

  @@index([workspaceId, createdAt])
  @@index([replyToId])
  @@index([sourceId])
  @@index([purgeAt])
}

/// AI transcript and summary of a recording (the AI summaries add-on). Both
/// are end-to-end encrypted on the team's device with the video's key, like
/// replies, so the server only ever stores ciphertext. Copies sent to other
/// clients share the original recording's insight.
model VideoInsight {
  videoId    String   @id
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// Ciphertext of the transcript (JSON: language and timed segments).
  transcript String
  /// Ciphertext of the summary (JSON: overview, key points, action items). Null if summarising failed.
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// AI summaries made per workspace per calendar month (UTC), for the fair-use cap.
model AiUsage {
  workspaceId String
  /// "YYYY-MM"
  month       String
  summaries   Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, month])
}

model UploadPart {
  videoId    String
  partNumber Int
  etag       String?
  sizeBytes  Int
  video      Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, partNumber])
}

enum ReplyKind {
  TEXT
  VIDEO
  AUDIO
}

/// One message in a video's conversation. Viewers can reply without an account.
model Reply {
  id           String    @id @default(cuid())
  kind         ReplyKind
  /// Ciphertext when encrypted (sealed with the conversation's video key).
  body         String?
  encrypted    Boolean   @default(false)
  timestampMs  Int?
  authorName   String
  createdAt    DateTime  @default(now())
  videoId      String
  mediaId      String?   @unique
  authorUserId String?
  video        Video     @relation("Conversation", fields: [videoId], references: [id], onDelete: Cascade)
  media        Video?    @relation("ReplyMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  authorUser   User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
}

model Reaction {
  id          String   @id @default(cuid())
  emoji       String
  timestampMs Int?
  createdAt   DateTime @default(now())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

/// Someone a creator works with (e.g. a personal trainer's client). Clients
/// never pay: each uses one of the workspace's client seats and gets a
/// private link to watch and reply to the videos sent to them.
model Client {
  id             String        @id @default(cuid())
  name           String
  email          String?
  /// Secret in the client's personal link. Treat like a password.
  token          String        @unique
  /// The client's end-to-end key, wrapped with the team key. The unwrapped key
  /// travels only in the link fragment (#k=…), which browsers never send to servers.
  teamKeyWrap    String?
  /// Fingerprint of the client's current key, set once it has been replaced.
  /// Lets the client's device notice an old key and pick up the new one.
  keyFingerprint String?
  /// The client turned reminder emails off (from an email's unsubscribe link or their inbox).
  remindersOff   Boolean       @default(false)
  /// First time the client opened their personal link (the one with their key).
  /// Until then a business is reminded to send it themselves.
  linkOpenedAt   DateTime?
  /// The staff member who looks after this client (Studio and Agency teams).
  assignedToId   String?
  assignedTo     User?         @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  removedAt      DateTime?
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  videos         Video[]
  items          Item[]
  keyRotations   KeyRotation[]

  @@index([workspaceId, removedAt])
}

enum ItemKind {
  TASK
  NOTE
}

/// A to-do or note, either general or about one client. The text is end-to-end
/// encrypted: with the team key when private, or with the client's key when
/// shared with that client (the team can unwrap the client key).
model Item {
  id           String     @id @default(cuid())
  kind         ItemKind
  body         String /// ciphertext
  done         Boolean    @default(false)
  dueAt        DateTime?
  shared       Boolean    @default(false)
  /// Repeat rule (lib/schedule.ts Repeat); the next occurrence is created when this one is done or overdue.
  repeat       Json?
  /// Occurrences of one repeating to-do share a seriesId.
  seriesId     String?
  spawnedNext  Boolean    @default(false)
  /// Reminder rules (lib/schedule.ts ReminderRule[]) and who gets them.
  reminders    Json?
  remindClient Boolean    @default(false)
  remindTeam   Boolean    @default(false)
  authorName   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspaceId  String
  clientId     String?
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduled    Reminder[]

  @@index([workspaceId, clientId])
  @@index([spawnedNext, dueAt])
}

enum ReminderTo {
  CLIENT
  TEAM
}

/// One reminder email waiting to go out.
model Reminder {
  id     String     @id @default(cuid())
  sendAt DateTime
  sentAt DateTime?
  to     ReminderTo
  error  String?
  itemId String
  item   Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([sentAt, sendAt])
  @@index([itemId])
}

/// Video bytes kept in Postgres by the "db" storage driver (previews and
/// small deployments without S3/R2). Each upload part is one row; the file
/// is the parts in order, so nothing is copied when an upload completes.
model StoredPart {
  key        String
  partNumber Int
  size       Int
  data       Bytes

  @@id([key, partNumber])
}

/// Fixed-window request counters for rate limiting (lib/rateLimit.ts).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// One-time code handing a web sign-in to the mobile app (PKCE, see /mobile/handoff).
model MobileCode {
  codeHash  String    @id
  challenge String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
}

/// A key replaced after someone left the team: the new key, wrapped with the
/// old one. Devices still holding the old key follow these to the current
/// key. Served only to current members (team key) or the client themselves.
model KeyRotation {
  id              String    @id @default(cuid())
  /// Fingerprint of the key that unwraps `wrap`.
  fromFingerprint String
  /// The next key, wrapped with the key named by fromFingerprint.
  wrap            String
  createdAt       DateTime  @default(now())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Set for a client's key; null for the team key.
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId])
}

enum TicketStatus {
  OPEN // the assistant is handling it
  NEEDS_HUMAN // handed to the founder; waiting on a person
  ANSWERED // a person replied
  CLOSED
}

enum SupportAuthor {
  CUSTOMER
  ASSISTANT
  STAFF
}

/// A support conversation. Starts with the AI assistant; escalated ones reach a person.
model SupportTicket {
  id          String           @id @default(cuid())
  /// Unguessable id the browser keeps so a signed-out visitor can come back to their chat.
  accessToken String           @unique
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  email       String?
  status      TicketStatus     @default(OPEN)
  /// The assistant's one-paragraph summary when it hands over.
  summary     String?
  urgent      Boolean          @default(false)
  messages    SupportMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    SupportAuthor
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum TeamNotificationKind {
  CLIENT_REPLY
  VIDEO_SENT
}

/// A team email waiting to go out. Several within 15 minutes for the same
/// person and conversation (replies) or sender (videos sent) are combined
/// into one short digest (lib/teamNotify.ts).
model TeamNotification {
  id          String               @id @default(cuid())
  kind        TeamNotificationKind
  /// Who gets the email.
  userId      String
  workspaceId String
  /// What one email covers: the conversation (replies) or the sender (videos sent).
  groupKey    String
  /// The staff member who sent the video (VIDEO_SENT).
  actorUserId String?
  clientId    String?
  videoId     String?
  createdAt   DateTime             @default(now())
  sentAt      DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sentAt, createdAt])
  @@index([userId, groupKey])
}

/// The last team email per person and group, so bursts send one email per 15 minutes.
model NotifyThrottle {
  key        String   @id
  lastSentAt DateTime
}

/// A reminder an owner or admin sends to a staff member: emailed, and shown
/// in the app until they dismiss it. Kept as history.
model StaffNotice {
  id          String    @id @default(cuid())
  workspaceId String
  fromUserId  String
  toUserId    String
  message     String
  /// Optional app path it links to (/clients/{id} or /v/{id}).
  link        String?
  linkLabel   String?
  createdAt   DateTime  @default(now())
  emailedAt   DateTime?
  dismissedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from        User      @relation("NoticeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("NoticeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, workspaceId, dismissedAt])
  @@index([workspaceId, createdAt])
}
