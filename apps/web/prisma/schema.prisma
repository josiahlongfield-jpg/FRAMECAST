generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  videos        Video[]
  comments      Comment[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Workspaces & billing ----------

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                   String       @id @default(cuid())
  name                 String
  plan                 Plan         @default(FREE)
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  members              Membership[]
  videos               Video[]
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ---------- Videos ----------

enum VideoStatus {
  RECORDING // chunks still arriving
  UPLOADED // raw file complete, playable as-is
  PROCESSING // transcoding to HLS
  READY // HLS available
  FAILED
}

model Video {
  id            String       @id // short public id used in share links
  title         String       @default("Untitled recording")
  status        VideoStatus  @default(RECORDING)
  mimeType      String
  durationMs    Int?
  sizeBytes     BigInt       @default(0)
  storageKey    String
  uploadId      String? // S3 multipart upload id
  playbackUrl   String? // HLS url once transcoded
  thumbnailUrl  String?
  viewCount     Int          @default(0)
  password      String?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ownerId       String
  workspaceId   String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parts         UploadPart[]
  comments      Comment[]
  reactions     Reaction[]

  @@index([workspaceId, createdAt])
}

model UploadPart {
  videoId    String
  partNumber Int
  etag       String?
  sizeBytes  Int
  video      Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, partNumber])
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  timestampMs Int?
  createdAt   DateTime @default(now())
  videoId     String
  authorId    String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Reaction {
  id          String   @id @default(cuid())
  emoji       String
  timestampMs Int?
  createdAt   DateTime @default(now())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}
