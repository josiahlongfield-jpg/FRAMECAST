# Postgres
DATABASE_URL="postgresql://framecast:framecast@localhost:5432/framecast"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email-only sign in for local dev and demos. NEVER enable in production.
AUTH_DEV_LOGIN=true

APP_URL="http://localhost:3000"

# Storage: leave S3_BUCKET empty to store files on local disk (.data/uploads).
# For Cloudflare R2 set S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Mux: adaptive HLS, thumbnails, auto captions (optional; raw file plays without it)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Scheme the mobile app registers (must match apps/mobile/app.json "scheme")
MOBILE_APP_SCHEME="framecast"
